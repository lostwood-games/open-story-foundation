Versions {
  language = "1"
  story    = "v1"
  dialogue = "v1"
}

Story shop {
  name  = "Shop"
  start = Dialogue.counter
}

Character merchant {
  name        = "Merchant"
  description = "Sells {{ Document.lantern }}."
}

Document lantern {
  name = "the lantern"
}

Variable has_lantern: Boolean = false
Variable money: Number = 10
Variable happiness: Number = -1
Variable gold: UnsignedNumber = 5 { description = "Coins the player carries." }

Dialogue counter {
  Node offer {
    speaker: merchant
    text: "{{ Document.lantern }} costs 3 gold. You have {{ Variable.gold }}."

    Option buy {
      text: "Buy it"
      requires: { gold >= 3, has_lantern: false }
      set: { gold -= 3, has_lantern: true, happiness += 1 }
      next: thanks
    }

    Option leave {
      text: "Leave"
      requires: { money != 2 }
      set: { money: 0 }
      next: Dialogue.street
    }
  }

  Node thanks {
    speaker: merchant
    text: """
      Thank you.
      Come again.
    """
  }
}

Dialogue street {
  Node outside {
    text: "The street is empty."
    next: beggar requires { has_lantern: true }  // only seen in the light
    next: dark requires { happiness < 0 }
    next: home
  }

  Node dark {
    text: "The empty street makes you feel even worse."
  }

  Node home {
    text: "You walk home."
  }

  Node beggar {
    text: "A beggar steps into the light of your lantern."
  }
}
