Versions {
  language = "1"
  story    = "v1"
  dialogue = "v1"
}

Story market {
  name  = "Market"
  start = Dialogue.stall
}

Variable gold: UnsignedNumber = 5

Dialogue stall {
  Node offer {
    text: "Cheap trinkets, for those who are not rich."

    Option buy {
      text: "I'll take one."
      requires: { gold >= 3, gold <= 10 }  // enough gold, but not rich
      set: { gold -= 3 }
    }

    Option leave {
      text: "No, thanks."
    }
  }
}
