Versions {
  language = "1"
  story    = "v1"
  dialogue = "v1"
}

Story shop {
  name  = "Shop"
  start = Dialogue.counter
}

Character merchant {
  name        = "Merchant"
  description = "Sells {{ Document.lantern }}."
}

Document lantern {
  name = "the lantern"
}

Variable has_lantern: Boolean = false
Variable mood: Number = -1
Variable gold: UnsignedNumber = 5

Dialogue counter {
  Node offer {
    speaker: merchant
    text: "{{ Document.lantern }} costs 3 gold. You have {{ Variable.gold }}."

    Option buy {
      text: "Buy it"
      requires: { gold >= 3, has_lantern: false }
      set: { gold -= 3, has_lantern: true, mood += 1 }
      next: thanks
    }

    Option leave {
      text: "Leave"
      requires: { mood != 2 }
      set: { mood: 0 }
      next: Dialogue.street
    }
  }

  Node thanks {
    speaker: merchant
    text: """
      Thank you.
      Come again.
    """
  }
}

Dialogue street {
  Node outside {
    text: "The street is empty."
  }
}
