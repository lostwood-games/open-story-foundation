{
  "apiVersion": "dialogue/v1",
  "kind": "Dialogue",
  "data": {
    "id": "innkeeper",
    "startNode": "hub",
    "nodes": {
      "hub": {
        "content": {
          "text": "What do you want to know?"
        },
        "options": {
          "rumours": {
            "next": "rumours",
            "content": {
              "text": "Any rumours?"
            }
          },
          "room": {
            "requires": {
              "rumours.played": true
            },
            "next": "room",
            "content": {
              "text": "And about that room?"
            }
          },
          "leave": {
            "requires": {
              "hub.room.selected": false,
              "Dialogue.cellar.door.played": false
            },
            "content": {
              "text": "Goodbye."
            }
          }
        }
      },
      "rumours": {
        "next": "hub",
        "content": {
          "text": "They say the cellar is haunted."
        }
      },
      "room": {
        "next": "hub",
        "content": {
          "text": "Two coins a night."
        }
      }
    }
  }
}
