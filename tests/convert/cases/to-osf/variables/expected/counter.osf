Dialogue counter {
  Node offer {
    speaker: merchant
    text: "{{ Document.lantern }} costs 3 gold. You have {{ Variable.gold }}."

    Option buy {
      text: "Buy it"
      requires:
        { gold >= 3, gold <= 20, has_lantern: false }
        or { god_mode: true }
      set: { gold -= 3, has_lantern: true, happiness += 1 }
      next: thanks
    }

    Option leave {
      text: "Leave"
      requires: { money != 2, money != 3 }
      set: { money: 0 }
      next: Dialogue.street
    }
  }

  Node thanks {
    speaker: merchant
    text: """
      Thank you.
      Come again.
    """
  }
}
