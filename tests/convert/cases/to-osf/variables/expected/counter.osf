Dialogue counter {
  Node offer {
    speaker: merchant
    text: "{{ Document.lantern }} costs 3 gold. You have {{ Variable.gold }}."

    Option buy {
      text: "Buy it"
      requires: { gold >= 3, has_lantern: false }
      set: { gold -= 3, has_lantern: true, mood += 1 }
      next: thanks
    }

    Option leave {
      text: "Leave"
      requires: { mood != 2 }
      set: { mood: 0 }
      next: Dialogue.street
    }
  }

  Node thanks {
    speaker: merchant
    text: """
      Thank you.
      Come again.
    """
  }
}
